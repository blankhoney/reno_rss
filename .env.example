DOMAIN=example.com

# Optional on VPS: keep real Authelia users outside tracked repo files.
# Example: /root/opt/myrss/secrets/users_database.yml
AUTHELIA_USERS_DATABASE_FILE=../authelia/users_database.yml

# Optional for CI/CD remote image deploys. LOCAL_BUILD=1 keeps local build mode.
IMAGE_REGISTRY=
AI_READER_WEB_IMAGE=
AI_READER_API_IMAGE=
AI_READER_WORKER_IMAGE=

AI_READER_API_UPSTREAM=api-prod:8000
AI_READER_WEB_UPSTREAM=web-prod:3000
AI_READER_AUTH_UPSTREAM=authelia-prod:9091
AI_READER_STAGING_API_UPSTREAM=api-staging:8000
AI_READER_STAGING_WEB_UPSTREAM=web-staging:3000
AI_READER_STAGING_AUTH_UPSTREAM=authelia-staging:9091
# Empty origins reject write requests; set the real public origins per environment.
AI_READER_CSRF_ALLOWED_ORIGINS=https://ai-reader.example.com,https://staging-ai-reader.example.com
# Staging-only public demo flag. Keep false in production.
AI_READER_ANONYMOUS_DEMO=false

MINIFLUX_ADMIN=admin
MINIFLUX_ADMIN_PASSWORD=change_me

DEMO_LANDING_ENABLED=true
DEMO_USERNAME=demo
DEMO_PASSWORD=change_me
DEMO_AUTHELIA_BASE_URL=https://staging-auth.example.com
DEMO_TARGET_URL=https://staging-ai-reader.example.com/?module=all&sort=default&lang=zh
DEMO_ALLOWED_ORIGIN=https://staging-ai-reader.example.com

POSTGRES_SUPERUSER_PASSWORD=change_me
POSTGRES_MINIFLUX_PASSWORD=change_me
POSTGRES_SCORING_PASSWORD=change_me

# keep change_me in sync with POSTGRES_MINIFLUX_PASSWORD
MINIFLUX_DATABASE_URL=postgres://miniflux:change_me@postgres:5432/miniflux?sslmode=disable
# keep change_me in sync with POSTGRES_SCORING_PASSWORD
SCORING_DATABASE_URL=postgres://scoring:change_me@postgres:5432/scoring?sslmode=disable

MINIFLUX_API_BASE_URL=http://miniflux:8080
MINIFLUX_API_KEY=change_me

READER_TENANT_ID=default
READER_MINIFLUX_USER_ID=1
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=change_me

LLM_PROVIDER=mock
# Local OpenAI-compatible profile (Ollama/vLLM). Use LLM_PROVIDER=local to enable.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=llama3.2
MINIMAX_API_KEY=change_me
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TEMPERATURE=0.2
MINIMAX_TOP_P=0.9
MINIMAX_MAX_COMPLETION_TOKENS=16384
MINIMAX_REASONING_SPLIT=true
MINIMAX_THINKING_TYPE=disabled
LLM_TIMEOUT_SECONDS=30
LLM_DAILY_CALL_BUDGET=500
AGENT_DAILY_CALL_BUDGET=20
LLM_RATELIMIT=5/minute;100/day
WRITE_RATELIMIT=30/minute
AUTH_RATELIMIT=5/minute;30/hour
API_RATELIMIT_DEFAULT=120/minute
SLOW_REQUEST_MS=500
WORKER_CONCURRENCY=1
WORKER_POLL_SECONDS=2
WORKER_JOB_LEASE_SECONDS=900
WORKER_RETRY_BACKOFF_SECONDS=60
WORKER_RETRY_BACKOFF_MAX_SECONDS=3600
WORKER_LOG_LEVEL=INFO
# Worker-side daily scoring cap. Set to 0 to disable; counts success and error score rows.
SCHEDULE_SCORE_DAILY_ARTICLE_CAP=60
# Unattended intelligence pipeline (sync + auto_score). Keep false until MiniMax account cap is set.
SCHEDULER_ENABLED=false
EXTERNAL_CONTENT_PROVIDER=none

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=change_me
SMTP_SENDER=noreply@blankhoney.xyz
